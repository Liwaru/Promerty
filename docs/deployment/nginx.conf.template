# REVIEW/RENDER ONLY. Never install this file with placeholders unchanged.
# Direct HTTPS + PHP-FPM topology; a proxy/CDN or Windows Apache requires a different reviewed configuration.
# Replace PROMERTY_DOMAIN, APP_PUBLIC_ROOT, TLS_CERT_CHAIN, TLS_PRIVATE_KEY,
# PHP_FPM_SOCKET, UPLOAD_LIMIT, AUDIT_LOG and ERROR_LOG only after G7 approval.
# Include the rendered file within the http context; run nginx -t before activation.
log_format promerty_security '$time_iso8601 method=$request_method status=$status bytes=$body_bytes_sent duration=$request_time';
# Preserve Laravel's no-referrer policy on the Google callback.
map $upstream_http_referrer_policy $promerty_referrer_policy {
    "" same-origin;
    default $upstream_http_referrer_policy;
}
server {
    listen 80;
    server_name PROMERTY_DOMAIN;
    return 308 https://PROMERTY_DOMAIN$request_uri;
}
server {
    listen 443 ssl;
    server_name PROMERTY_DOMAIN;
    root APP_PUBLIC_ROOT;
    index index.php;
    ssl_certificate TLS_CERT_CHAIN;
    ssl_certificate_key TLS_PRIVATE_KEY;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size UPLOAD_LIMIT;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy $promerty_referrer_policy always;
    # No query strings, cookies, reset tokens or signed media URLs in access logs.
    access_log AUDIT_LOG promerty_security;
    # Treat server error logs as sensitive: upstream errors can contain request URLs.
    # Approve their ACL, sanitization, rotation and retention before public traffic.
    error_log ERROR_LOG warn;
    location / { try_files $uri $uri/ /index.php?$query_string; }
    location ~ /\. { deny all; }
    location = /index.php {
        include fastcgi_params;
        fastcgi_pass unix:PHP_FPM_SOCKET;
        fastcgi_hide_header Referrer-Policy;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_param HTTPS on;
        fastcgi_param HTTP_PROXY "";
    }
    # Uploaded/other PHP files must never reach PHP-FPM.
    location ~ \.php(?:/|$) { return 404; }
    # Do not alias storage/app/private or QA artifacts into public web paths.
    # HSTS/CSP, certificate renewal and monitoring require the rendered-environment tests.
}
