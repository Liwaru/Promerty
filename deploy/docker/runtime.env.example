APP_NAME=Promerty
APP_ENV=production
APP_DEBUG=false
APP_URL=https://staging.example.invalid
APP_KEY=
APP_LOCALE=id

DB_CONNECTION=mariadb
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
MYSQL_ATTR_SSL_CA=/run/promerty-db-ca.pem

SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_COOKIE=promerty_staging_session
SANCTUM_STATEFUL_DOMAINS=staging.example.invalid
CACHE_STORE=database
PASSWORD_LOGIN_CACHE_STORE=database
CACHE_PREFIX=promerty-staging-cache
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=150
FILESYSTEM_DISK=local

LOG_CHANNEL=stderr
LOG_LEVEL=warning
MAIL_MAILER=array
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_FROM_ADDRESS=
MAIL_USERNAME=
MAIL_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://staging.example.invalid/auth/google/callback
PROMERTY_SECURITY_QA_ROLLOUT=false
PROMERTY_EMAIL_OTP_ROLLOUT=false
AGENT_RESUMABLE_VIDEO=false
AGENT_VIDEO_MAX_BYTES=750000000
AGENT_VIDEO_OPTIMIZATION=false
