log_format promerty '$time_iso8601 method=$request_method status=$status bytes=$body_bytes_sent duration=$request_time';
map $upstream_http_referrer_policy $promerty_referrer_policy {
    "" same-origin;
    default $upstream_http_referrer_policy;
}

server {
    listen 8080 default_server;
    server_name _;
    access_log /dev/stdout promerty;
    return 404;
}

server {
    listen 8080;
    server_name ${PROMERTY_SERVER_NAME};
    root /srv/promerty/public;
    server_tokens off;
    autoindex off;
    client_max_body_size 128m;
    client_body_timeout 120s;
    send_timeout 120s;
    access_log /dev/stdout promerty;
    error_log /dev/stderr error;
    set_real_ip_from ${PROMERTY_TRUSTED_PROXY};
    real_ip_header X-Forwarded-For;
    real_ip_recursive off;
    add_header Referrer-Policy $promerty_referrer_policy always;
    add_header X-Content-Type-Options nosniff always;

    location / { try_files $uri /index.php?$query_string; }
    location = /storage { return 404; }
    location ^~ /storage/ {
        # Public disk only. Reject dotfiles, symlinks and non-image files.
        if ($uri !~* "^/storage/[a-z0-9_-]+(?:/[a-z0-9_-]+)*/[a-z0-9_-]+\.(?:jpeg|jpg|png|webp|gif)$") { return 404; }
        alias /srv/promerty-public/;
        disable_symlinks on from=/srv/promerty-public/;
    }
    location ~ /\. { return 404; }
    location ~* \.(?:sql|sqlite|gpg|pem|key|bak|ini|log)(?:/|$) { return 404; }
    location ~* \.php(?:/|$) { return 404; }

    location = /index.php {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $promerty_fpm app:9000;
        fastcgi_pass $promerty_fpm;
        fastcgi_connect_timeout 5s;
        fastcgi_send_timeout 120s;
        fastcgi_read_timeout 220s;
        fastcgi_request_buffering off;
        fastcgi_buffering off;
        fastcgi_hide_header Referrer-Policy;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /app/public/index.php;
        fastcgi_param DOCUMENT_ROOT /app/public;
        fastcgi_param HTTPS ${PROMERTY_FCGI_HTTPS} if_not_empty;
        fastcgi_param HTTP_PROXY "";
        fastcgi_param HTTP_X_FORWARDED_HOST "";
        fastcgi_param HTTP_X_FORWARDED_PROTO "";
    }
}
