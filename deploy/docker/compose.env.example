# Non-secret Compose settings. Always use --env-file, independently from Laravel .env.
PROMERTY_RELEASE=staging-001
PROMERTY_HTTP_PORT=8080
PROMERTY_SERVER_NAME=staging.example.invalid
PROMERTY_TRUSTED_PROXY=127.0.0.1
PROMERTY_RUNTIME_ENV=/etc/promerty/runtime.env
PROMERTY_DB_CA_FILE=/etc/promerty/ca/mariadb.pem
PROMERTY_STORAGE_VOLUME=promerty-staging-storage
PROMERTY_PUBLIC_VOLUME=promerty-staging-public
